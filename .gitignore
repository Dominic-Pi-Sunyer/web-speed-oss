# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Page cache (runtime data) ─────────────────────────────────────────────────
# Whole directory, not just the two extensions it happens to write today —
# cached pages are other people's content and must never land in a public repo.
cache/

# ── macOS / Windows / editors ─────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Cache
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ── Environment / secrets ─────────────────────────────────────────────────────
# Catch-all, not a list. The old rules covered .env, .env.local and
# .env.*.local — but NOT .env.production or .env.staging, which would have been
# committed silently to a public repo.
.env
.env.*
!.env.example

# Keys and credentials, whatever they get named
*.pem
*.key
*.p12
*.pfx
credentials.json

# ── Claude Code internals ─────────────────────────────────────────────────────
.claude/
